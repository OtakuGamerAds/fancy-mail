{
  "name": "fancy-mail",
  "productName": "Fancy Mail",
  "version": "0.1.3",
  "description": "A calm, fast email client for many accounts, with an MCP server so your AI agents can organize your mail from the outside.",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:browser": "node scripts/dev.mjs --browser",
    "build": "pnpm -r --filter ./packages/* --filter ./apps/* run build",
    "build:server": "node scripts/build-server.mjs",
    "typecheck": "pnpm -r run typecheck",
    "test": "node scripts/electron-node.mjs node_modules/vitest/vitest.mjs run",
    "snapshot": "node scripts/snapshot.mjs",
    "icons": "node scripts/make-icon.mjs",
    "dist": "node scripts/dist.mjs",
    "release": "node scripts/release.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "concurrently": "^9.2.0",
    "electron": "44.10.2",
    "typescript": "~5.9.3",
    "vitest": "^4.1.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild"
    ]
  },
  "author": "OtakuGamerAds",
  "license": "MIT"
}
